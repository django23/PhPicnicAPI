{
    "name": "django23/php-picnic-api",
    "description": "Unofficial, framework-agnostic PHP client for the Picnic supermarket API (PSR-18).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "picnic",
        "api",
        "client",
        "supermarket",
        "groceries",
        "psr-18"
    ],
    "homepage": "https://github.com/django23/PhPicnicAPI",
    "authors": [
        {
            "name": "Django Eijgensteijn",
            "homepage": "https://github.com/django23"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "mockery/mockery": "^1.6",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.6",
        "symplify/phpstan-rules": "^14.17",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "PhPicnic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhPicnic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse --memory-limit=1G",
        "refactor": "rector process --dry-run",
        "refactor:fix": "rector process",
        "validate:composer": "@composer validate --strict",
        "check": [
            "@validate:composer",
            "@lint",
            "@refactor",
            "@analyse",
            "@test"
        ],
        "fix": [
            "@refactor:fix",
            "@lint:fix"
        ],
        "smoke": "@php scripts/live-smoke.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite",
        "lint": "Check code style (no changes written)",
        "lint:fix": "Fix code style",
        "analyse": "Run PHPStan at max level",
        "refactor": "Show Rector refactors still pending (no changes written)",
        "refactor:fix": "Apply Rector refactors",
        "validate:composer": "Validate composer.json strictly",
        "check": "Run every check: validate, lint, refactor, analyse, test (used by CI)",
        "fix": "Apply all automatic fixes: Rector, then code style",
        "smoke": "Live read-only smoke test against the real Picnic API (needs .env, asks for the SMS code)"
    }
}
